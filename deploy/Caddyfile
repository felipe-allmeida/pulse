# Pulse — single front door: serves the built SPA and reverse-proxies the API.
#
# {$PULSE_DOMAIN::80} — Caddy's env-var-with-default syntax. Locally
# PULSE_DOMAIN is unset, so this resolves to plain ":80" (no TLS, works over
# bare HTTP for `docker compose up`). In prod, set PULSE_DOMAIN to a real
# hostname (e.g. "pulse.example.com") and Caddy automatically provisions and
# renews a Let's Encrypt certificate for it.
#
# {$PULSE_API_UPSTREAM:api:8080} — the API upstream. Defaults to the compose
# service name `api:8080` (correct for local `docker compose up`). In a shared
# Docker host where several stacks each define an `api` service, that bare name
# can collide on a shared proxy network and route to the WRONG backend — so
# prod sets PULSE_API_UPSTREAM to the stack-unique container name (e.g.
# `pulse-api:8080`), which resolves unambiguously.
#
# trusted_proxies private_ranges — in prod this Caddy sits behind NPM
# (another private-network hop), so without this Caddy would treat NPM as the
# client and either drop or overwrite the X-Forwarded-For it set for the real
# visitor. Trusting the RFC1918 ranges makes Caddy accept NPM's X-Forwarded-For
# and append its own hop, so the api (ForwardLimit=2) sees the full
# NPM -> Caddy chain and can resolve the original visitor IP. Locally, with no
# NPM in front, there's simply no untrusted hop to strip — the directly
# connecting client IP is preserved either way.
{$PULSE_DOMAIN::80} {
	# SignalR negotiate + REST endpoints.
	handle /api/* {
		reverse_proxy {$PULSE_API_UPSTREAM:api:8080} {
			trusted_proxies private_ranges
		}
	}

	# SignalR hub — Caddy proxies the WebSocket upgrade automatically.
	handle /hub/* {
		reverse_proxy {$PULSE_API_UPSTREAM:api:8080} {
			trusted_proxies private_ranges
		}
	}

	# Health check — proxied straight to the api (not served by the SPA
	# fallback), so hitting Caddy's own :80 actually reflects api liveness.
	handle /health {
		reverse_proxy {$PULSE_API_UPSTREAM:api:8080} {
			trusted_proxies private_ranges
		}
	}

	# The documents now carry each route's prerendered markup (see
	# web/plugins/aio.ts), so they are tens of kilobytes of highly repetitive
	# HTML rather than a one-line shell — and nothing here was compressing
	# them. Text compression is the single cheapest win available on this
	# stack; zstd first, gzip for clients that do not speak it.
	encode zstd gzip

	# Markdown mirrors (/about.md, /llms.txt …) are plain text for agents, not
	# downloads. The caddy:alpine image ships no /etc/mime.types, so Go's mime
	# package has no mapping for .md and would serve it as octet-stream —
	# which makes a browser download the file instead of showing it.
	@markdown path *.md
	header @markdown Content-Type "text/markdown; charset=utf-8"

	# Static files get their own `handle` blocks, ABOVE the SPA one, and they
	# deliberately have no try_files.
	#
	# `handle` blocks are mutually exclusive — the first one whose matcher fits
	# wins and the request never reaches the ones below — which is the whole
	# point here. A matcher *inside* the SPA handle only labels the request
	# path: by the time the Cache-Control header was stamped, the SPA's
	# `try_files … /index.html` had already turned a request for a missing
	# asset into a 200 carrying index.html, so a .js URL came back as HTML with
	# a year of `immutable` on it. Content hashing is what normally makes a
	# stale asset URL self-correcting (v2 deploys, a tab still on v1 lazily
	# fetches a v1 chunk, it 404s, the app reloads); caching a document under
	# that URL for a year destroys that, and rolling back to v1 then resolves
	# the real chunk's URL out of cache as HTML.
	#
	# handle_errors below keeps the same poisoning from happening in reverse:
	# without it these `header` lines apply to the 404 too, and a year-long
	# immutable 404 breaks the rollback just as thoroughly.
	handle /assets/* {
		# Vite content-hashes every name in here, so the bytes behind a given
		# URL never change — safe to freeze forever.
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}

	# Same reasoning, same fix: /screenshots/* is an image directory with no SPA
	# route beneath it, so the fallback could only ever answer an <img> request
	# with a whole HTML document. Milder — a week rather than a year, and no
	# `immutable`, so it does expire — but a broken image pinned for a week is
	# still a week, and there is no reason to prefer a lying 200 to an honest
	# 404. Files under public/ keep their authored names (no content hash),
	# which is why the window is short.
	handle /screenshots/* {
		header Cache-Control "public, max-age=604800"
		root * /srv
		file_server
	}

	# Everything else: the built SPA, with client-side-router fallback.
	#
	# The `{path}.html` step is what serves the AIO documents the web build
	# generates (see web/plugins/aio.ts): /about resolves to /srv/about.html,
	# /projects/pulse to /srv/projects/pulse.html — each one a complete
	# document with that route's title, description, JSON-LD, and a no-script
	# copy of its text, for the AI crawlers that never run the bundle. Every
	# one of them still boots the same SPA, so browsers are unaffected. Routes
	# without a generated document (and anything unknown) fall through to the
	# SPA shell exactly as before.
	#
	# `{path}.html` is tried FIRST, before the literal path, because try_files
	# matches directories too: /projects would otherwise resolve to the
	# /srv/projects/ directory (which holds the per-project documents and has
	# no index.html of its own) and 404 instead of serving projects.html. The
	# extra stat per asset request is not worth reordering for.
	handle {
		# Cache-Control, absent until now — which is why every visit refetched
		# the whole asset graph. Two non-overlapping matchers rather than a
		# broad default plus overrides, so the rule for any given request is
		# readable from one line. /assets/* and /screenshots/* are no longer
		# named here: they are handled above and never reach this block.
		#
		# These few files keep their authored names (they come from public/, so
		# no content hash), hence a week rather than forever.
		#
		# The documents are `no-cache` because each one embeds the hashed asset
		# names: a cached document pins a released build in place and the next
		# deploy is invisible until it expires.
		@public path /favicon.ico /favicon.svg /apple-touch-icon.png /og.png /cv.pdf
		header @public Cache-Control "public, max-age=604800"

		@documents not path /favicon.ico /favicon.svg /apple-touch-icon.png /og.png /cv.pdf
		header @documents Cache-Control "no-cache"

		root * /srv
		try_files {path}.html {path} /index.html
		file_server
	}

	# An error response inherits whatever Cache-Control the matching block
	# already set on it, so without this a missing /assets/* file 404s with a
	# year of `immutable` — the same rollback poisoning as the 200 fallback,
	# just inverted (roll back to a build whose chunk really does exist and the
	# client answers from a cached 404 instead). Nothing that failed is worth
	# remembering; `no-store` on every error, unconditionally.
	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
