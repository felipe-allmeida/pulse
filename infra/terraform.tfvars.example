# Copy to terraform.tfvars and fill in — terraform.tfvars is gitignored.
# The two API tokens are NOT set here; export them as environment variables
# instead (see infra/README.md):
#   export TF_VAR_hcloud_token="..."
#   export TF_VAR_hetznerdns_token="..."   # only if manage_dns = true

ssh_public_key = "ssh-ed25519 AAAA... you@example.com"
# or: ssh_public_key = file("~/.ssh/id_ed25519.pub")

server_type = "cx22"
location    = "nbg1"
server_name = "pulse"

# --- Optional DNS (leave off unless you want Terraform to manage it) ---
manage_dns  = false
dns_zone_id = ""
domain      = ""
