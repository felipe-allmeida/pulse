# Copy to terraform.tfvars and fill in — terraform.tfvars is gitignored.
# The API token is NOT set here; export it as an environment variable
# instead (see infra/README.md):
#   export TF_VAR_hcloud_token="..."

ssh_public_key = "ssh-ed25519 AAAA... you@example.com"
# or: ssh_public_key = file("~/.ssh/id_ed25519.pub")

server_type = "cx22"
location    = "nbg1"
server_name = "pulse"
